{
    "rules": {
      ".read": "auth != null",  // Only authenticated users can read data
      ".write": "auth != null",  // Only authenticated users can write data
      
      "users": {
        "$uid": {
          ".read": "$uid === auth.uid",  // Users can only read their own data
          ".write": "$uid === auth.uid"  // Users can only write to their own data
        }
      },
  
      "products": {
        ".read": "auth != null",  // Public read access, anyone can view products
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"  // Only admins can write/update products
      },
  
      "orders": {
        "$orderId": {
          ".read": "$orderId === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin'",  // User can read their own orders or admin can read all
          ".write": "$orderId === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin'"  // User can write their own orders, or admin can write
        }
      },
      
      "page_views": {
        ".read": true,
        "$date": {
          ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "$page": {
            ".write": "newData.exists()",
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        }
      },

      "blog_posts": {
        ".read": true,  // Public read access for blog (listing and post pages)
        "$postId": {
          "views": {
            ".write": true  // Anyone can increment view count on visit
          }
        }
      }
    }
  }
  